
# NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# APPWRITE
# `local` uses the built-in file backed database (no Appwrite account needed),
# `cloud` uses Appwrite Cloud. When it is not set the app picks cloud when an
# API key is present and falls back to local otherwise.
APPWRITE_BACKEND=local
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=662cd3d0000d7d095714
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_ITEM_COLLECTION_ID=
APPWRITE_BANK_COLLECTION_ID=
APPWRITE_TRANSACTION_COLLECTION_ID=
NEXT_APPWRITE_KEY=

# PLAID
# Leave empty to use the built-in demo bank account.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions,identity
PLAID_COUNTRY_CODES=US,CA

# DWOLLA
# Leave empty to emulate the transfers locally.
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_BASE_URL=https://api-sandbox.dwolla.com
DWOLLA_ENV=sandbox
